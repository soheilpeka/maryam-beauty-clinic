{
  "name": "maryam-beauty-clinic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src e2e prisma scripts *.config.ts *.config.mjs tsx-sandbox-shim.cjs",
    "security:maintain-local": "node --import tsx --require ./tsx-sandbox-shim.cjs scripts/security-maintenance.ts --apply-local",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node --import tsx --require ./tsx-sandbox-shim.cjs prisma/seed.ts",
    "prisma:bootstrap-admin": "node --import tsx --require ./tsx-sandbox-shim.cjs prisma/bootstrap-admin.ts",
    "prisma:publish-packages": "node --import tsx --require ./tsx-sandbox-shim.cjs prisma/publish-skin-programs.ts",
    "prisma:import-comparisons": "node --import tsx --require ./tsx-sandbox-shim.cjs prisma/import-comparisons.ts",
    "prisma:migrate-booking-contacts": "node --import tsx --require ./tsx-sandbox-shim.cjs prisma/migrate-booking-contacts.ts",
    "prisma:init-staging": "node --env-file=.env.staging --require ./prisma/staging-guard.cjs --import tsx --require ./tsx-sandbox-shim.cjs prisma/init-staging.ts",
    "prisma:seed-staging": "node --env-file=.env.staging --require ./prisma/staging-guard.cjs --import tsx --require ./tsx-sandbox-shim.cjs prisma/seed.ts",
    "prisma:bootstrap-admin-staging": "node --env-file=.env.staging --require ./prisma/staging-guard.cjs --import tsx --require ./tsx-sandbox-shim.cjs prisma/bootstrap-admin.ts",
    "prisma:refresh-salon-media": "node --import tsx --require ./tsx-sandbox-shim.cjs prisma/refresh-salon-media.ts",
    "prisma:refresh-salon-media-staging": "node --env-file=.env.staging --require ./prisma/staging-guard.cjs --import tsx --require ./tsx-sandbox-shim.cjs prisma/refresh-salon-media.ts",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@img/sharp-wasm32": "^0.35.5",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "libsql": "^0.5.29",
    "next": "^16.3.6",
    "next-intl": "^4.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
