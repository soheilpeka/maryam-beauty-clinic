// Maryam C Beauté - Prisma schema
// All datetimes are stored as UTC and rendered in the salon timezone (see SALON_TIMEZONE).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// A service offered by the salon (price is integer cents, CAD).
model Service {
  id          String   @id @default(cuid())
  /// Stable key used to link translations and booking references
  slug        String   @unique
  name        String
  nameFr      String?
  description String?
  descriptionFr String?
  /// Price in cents (CAD)
  price       Int
  /// Duration in minutes
  duration    Int
  /// Service category used for grouping on the public site
  category    String   @default("General")
  /// Optional buffer minutes added after the service before the next booking
  bufferMin   Int      @default(0)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
  order       Int      @default(0)
  bookings    Booking[]
  services    StaffService[]
  images      ServiceImage[]
  packages    PackageService[]

  @@index([active])
}

model ServiceImage {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url       String
  altEn     String
  altFr     String
  order     Int     @default(0)

  @@index([serviceId, order])
}

model Staff {
  id          String         @id @default(cuid())
  /// Stable key used for translations
  slug        String         @unique
  name        String
  role        String         @default("Specialist")
  bio         String?
  bioFr       String?
  avatarUrl   String?
  active      Boolean        @default(true)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime?      @updatedAt
  bookings    Booking[]
  services    StaffService[]
  schedules   StaffSchedule[]
  daysOff     DayOff[]

  @@index([active])
}

/// Many-to-many between staff and the services they can perform.
model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

/// Weekly recurring availability per staff member. startTime/endTime are minutes-from-midnight
/// in the salon timezone, dayOfWeek is 0=Sunday..6=Saturday (JS Date.getDay()).
model StaffSchedule {
  id        String      @id @default(cuid())
  staffId   String
  dayOfWeek Int
  startTime Int
  endTime   Int
  staff     Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  breaks    Break[]

  @@unique([staffId, dayOfWeek, startTime])
  @@index([staffId, dayOfWeek])
}

/// A break inside a StaffSchedule window (minutes-from-midnight, salon local time).
model Break {
  id        String       @id @default(cuid())
  scheduleId String
  startTime Int
  endTime   Int
  schedule  StaffSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

/// Full or partial days off (vacation, holidays). Optional start/end minutes allow half days.
/// Dates are stored as UTC midnight of the salon-local date.
model DayOff {
  id       String   @id @default(cuid())
  staffId  String?
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date     DateTime
  /// Optional partial-day off, minutes-from-midnight salon local time
  startMin Int?
  endMin   Int?
  note     String?

  @@index([staffId, date])
}

/// Normalized customer record, keyed by email so repeat bookings are linked.
model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String
  notes     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([email])
}

model Booking {
  id         String       @id @default(cuid())
  /// Public reference shown to the customer
  ref        String       @unique
  customerId String
  /// Contact submitted for this request; legacy bookings fall back to Customer.
  customerNameSnapshot String?
  customerEmailSnapshot String?
  customerPhoneSnapshot String?
  serviceId  String
  staffId    String
  /// UTC start of the appointment
  startUtc   DateTime
  /// UTC end = start + service duration + buffer
  endUtc     DateTime
  status     BookingStatus @default(PENDING)
  /// Total price in cents (CAD) snapshot at booking time
  priceTotal Int
  /// Historical service snapshot. Nullable only for records created before this schema field.
  serviceNameSnapshot String?
  serviceNameFrSnapshot String?
  locale String @default("en")
  serviceSlugSnapshot String?
  durationMinSnapshot Int?
  /// Optional customer note
  note       String?
  /// Timestamp of the last status change
  updatedAt  DateTime     @updatedAt
  createdAt  DateTime     @default(now())

  customer   Customer     @relation(fields: [customerId], references: [id])
  service    Service      @relation(fields: [serviceId], references: [id])
  staff      Staff        @relation(fields: [staffId], references: [id])

  /// Race-safety is enforced by an atomic INSERT ... WHERE NOT EXISTS (overlap) in
  /// src/lib/booking.ts; see the note there for why a (staffId, startUtc) unique index is
  /// deliberately NOT used (it would also block re-booking a slot after a cancellation).
  @@index([serviceId, startUtc])
  @@index([customerId])
  @@index([status, startUtc])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Salon-level configuration (single row, id = "default").
model BusinessSetting {
  id                String  @id @default("default")
  name              String  @default("Maryam C Beauté")
  timezone          String  @default("America/Toronto")
  currency          String  @default("CAD")
  phone             String?
  email             String?
  address           String?
  city              String?
  mapEmbedUrl       String?
  /// Minutes to book in the future at minimum (lead time)
  leadTimeMin       Int     @default(60)
  /// How many days ahead customers can book
  bookingWindowDays Int     @default(60)
  slotIntervalMin   Int     @default(30)
}

/// DEMO placeholder gallery image metadata. Do not imply real customer photos.
model GalleryItem {
  id        String     @id @default(cuid())
  mediaId   String?
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  imageUrl  String
  /// Legacy fields retained for a non-destructive transition of existing demo rows.
  title     String?
  altText   String?
  altEn     String?
  altFr     String?
  captionEn String?
  captionFr String?
  category  String     @default("General")
  active    Boolean    @default(true)
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt

  @@index([active, order])
}

/// Provider-neutral image metadata. For now assets point to a validated HTTPS URL or public path.
model ComparisonItem {
  id            String @id @default(cuid())
  name          String
  nameFr        String
  description   String @default("")
  descriptionFr String @default("")
  imageUrl      String
  afterImageUrl String
  beforeCrop    Json
  afterCrop     Json
  aspectRatio   Float @default(1.3333333333)
  category      String @default("laser")
  active        Boolean @default(true)
  order         Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, order])
}

model MediaAsset {
  id        String        @id @default(cuid())
  url       String        @unique
  provider  String        @default("url")
  mimeType  String?
  sizeBytes Int?
  width     Int?
  height    Int?
  createdAt DateTime      @default(now())
  galleries GalleryItem[]
}

/// Bounded, processed CMS photographs. Drafts are readable only by signed-in admins.
model MediaUpload {
  id        String   @id
  data      Bytes
  sizeBytes Int
  width     Int
  height    Int
  createdAt DateTime @default(now())
}

model Package {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  nameFr         String
  description    String?
  descriptionFr  String?
  price          Int
  sessions       Int              @default(1)
  validityDays   Int?
  badge          String?
  imageUrl       String?
  active         Boolean          @default(true)
  order          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  services       PackageService[]
  images         PackageImage[]

  @@index([active, order])
}

model PackageService {
  packageId String
  serviceId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
  @@index([serviceId])
}

model PackageImage {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  url       String
  altEn     String
  altFr     String
  order     Int     @default(0)

  @@index([packageId, order])
}

/// DEMO placeholder FAQ entry. Marked demo in the seed; these are editorial samples.
model FaqItem {
  id       String  @id @default(cuid())
  question String
  answer   String
  locale   String
  active   Boolean @default(true)
  order    Int     @default(0)

  @@index([locale, active])
}

/// DEMO placeholder testimonial. Explicitly a demo entry, not a real customer review.
model Review {
  id     String  @id @default(cuid())
  author String
  /// DEMO marker is enforced in the seed; rating is a placeholder
  rating Int
  text   String
  locale String
  source String  @default("demo")
  active Boolean @default(true)
  order  Int     @default(0)

  @@index([locale, active])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  /// bcrypt hash, never the plaintext
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  sessions     AdminSession[]
  auditLogs    AuditLog[]
}

/// Server-side session for the admin dashboard. The cookie carries the raw token; the DB
/// stores only its sha256 digest so a leaked database cannot be replayed as a live session.
/// Deleting a row (logout) invalidates the session server-side, even if the cookie remains.
/// Per-email login failure tracking for rate limiting. Keyed by the submitted email
/// (lowercased) so the limiter behaves identically for existing and non-existing accounts,
/// which avoids leaking which emails are real.
model LoginFailure {
  /// Normalized submitted email
  email       String   @id
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
  /// Until when the email is locked after too many failures (null = not locked)
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// sha256 of the raw session token (the raw token only ever lives in the cookie)
  tokenHash String   @unique
  /// sha256 of the CSRF token bound to this session
  csrfHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

/// Tamper-evident record of admin actions (who/what/when/where). Written by every
/// state-changing /api/admin route via src/lib/audit.ts; the dashboard never deletes rows.
model AuditLog {
  id        String     @id @default(cuid())
  /// AdminUser id of the actor, null if the session was deleted after the fact
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  /// Short machine-readable action key, e.g. "booking.confirm"
  action    String
  /// Entity type the action targeted, e.g. "Booking"
  targetType String?
  /// Entity id the action targeted
  targetId  String?
  /// Human-readable detail; never secrets or tokens
  detail    String?
  /// Client IP of the request, best effort
  ip        String?
  createdAt DateTime   @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}


// ============================================================
// STORE (e-commerce extension)
// Retail products, customer orders and store configuration. Orders are guest checkout:
// contact and shipping details are snapshotted on the order, so history survives product
// edits and deletions exactly as the customer saw them at purchase time.
// ============================================================

/// A retail product sold through the online store. Prices are integer cents (CAD).
model Product {
  id          String   @id @default(cuid())
  /// Stable key used for URLs and translations
  slug        String   @unique
  /// Merchant-facing stable stock identifier
  sku         String?  @unique
  name        String
  nameFr      String?
  description String?
  descriptionFr String?
  /// Price in cents (CAD)
  price       Int
  /// Optional strikethrough "was" price in cents, for sale display only
  compareAtPrice Int?
  /// Optional actual sale price; public checkout uses this when present.
  salePrice  Int?
  /// Product category used for grouping/filtering on the store page
  category    String   @default("General")
  /// Path or URL of the product image
  imageUrl    String?
  /// Units in stock. 0 = sold out; negative stock is never created.
  stock       Int      @default(0)
  /// Hide a product from the store without deleting it (keeps order history intact).
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  /// Seeded placeholders stay out of the public store until replaced by owner-approved data.
  demo        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  order       Int      @default(0)
  orderItems  OrderItem[]
  images      ProductImage[]

  @@index([active])
  @@index([active, featured, order])
}

/// Ordered product gallery. The Product.imageUrl field remains the primary/card image;
/// this table supplies additional detail-page photography without storing JSON blobs.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altEn     String
  altFr     String
  order     Int     @default(0)

  @@index([productId, order])
}

/// A customer order from the store. Guest checkout: contact + shipping are snapshotted.
model Order {
  id        String      @id @default(cuid())
  /// Public reference shown to the customer, e.g. MBC-S-20260926-A3F2K
  ref       String      @unique
  status    OrderStatus @default(PENDING)
  /// Browser-generated attempt id. Retries with the same key return the same order.
  idempotencyKey String? @unique
  locale    String      @default("en")
  /// Customer contact snapshot
  name      String
  email     String
  phone     String
  /// Shipping address snapshot
  address   String
  city      String
  province  String?
  postalCode String?
  country   String      @default("Canada")
  note      String?
  /// Money snapshot in cents (CAD)
  subtotalCents Int
  shippingCents Int
  taxCents Int @default(0)
  totalCents Int
  /// Carrier details added by the salon when an order is dispatched.
  shippingCarrier String?
  trackingNumber String?
  trackingUrl String?
  /// Reservation lifecycle. Stock is decremented atomically before payment, committed on
  /// PAID, and restored once on failure/expiry/cancellation/refund.
  reservationExpiresAt DateTime?
  inventoryReservedAt  DateTime?
  inventoryCommittedAt DateTime?
  inventoryRestoredAt  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
  paymentAttempts PaymentAttempt[]

  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
  @@index([email])
}

/// One line of an order. Product name/price are snapshotted so an order always reads the
/// same even if the product is later renamed, repriced or deleted (product is nullable and
/// nulls on delete rather than cascading away the salon's history).
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Product name snapshot at purchase time
  name      String
  /// Product slug snapshot, kept for a "view product" link back to the catalog
  slug      String
  /// Merchant SKU snapshot for fulfilment even if the product is later changed/deleted
  sku       String?
  imageUrl  String?
  unitPriceCents Int
  quantity  Int
  lineTotalCents Int

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  EXPIRED
  REFUNDED
}

/// Non-sensitive gateway attempt metadata. Never stores card numbers, CVV or credentials.
model PaymentAttempt {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  status      PaymentStatus
  reference   String?
  /// PaymentIntent returned by Stripe Checkout; never a card credential.
  paymentIntentId String?
  amountCents Int
  message     String?
  createdAt   DateTime      @default(now())

  @@index([orderId, createdAt])
  @@index([reference])
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  ERROR
}

/// Shared sliding-window budgets. Keys are HMACs, never customer data or raw IPs.
model RateLimitBucket {
  key       String @id
  hitsJson  String
  expiresAt BigInt

  @@index([expiresAt])
}

/// Store-level configuration (single row, id = "default").
model StoreSetting {
  id        String  @id @default("default")
  /// Flat shipping fee in cents (CAD) applied when the free-shipping threshold is not met
  shippingFeeCents Int @default(0)
  /// Subtotal in cents at/above which shipping is free; 0 = shipping is never free
  freeShippingThresholdCents Int @default(0)
  /// Master switch so the salon can close the store while keeping the catalog visible
  enabled   Boolean @default(true)
  /// Maximum lifetime of an unpaid stock reservation.
  reservationMinutes Int @default(15)
}
