# Salon display timezone (IANA name). Times are stored as UTC and rendered in this zone.
SALON_TIMEZONE=America/Toronto
# Database: use a local file for development or a libSQL URL for hosting.
DATABASE_URL=file:./prisma/dev.db
DATABASE_AUTH_TOKEN=
# Base URL used in signed booking links and emails
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Secret used to sign manage/cancel links (any long random string in production)
BOOKING_LINK_SECRET=dev-only-change-me-in-production
# Required only while creating the first administrator with prisma/bootstrap-admin.ts.
# Supply unique values through the deployment environment; never commit real credentials.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Notifications: mock logs only; resend sends email through Resend after sender verification
NOTIFICATION_PROVIDER=mock
ADMIN_NOTIFICATION_EMAIL=Maryam_champir@yahoo.com
# Required only for NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Payments default to a configuration-safe Stripe test-mode boundary. Set PAYMENT_PROVIDER=mock
# only for isolated local/e2e demos. A hosted Checkout/PaymentIntent adapter and webhook secret
# must be connected before accepting real customer payments.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
